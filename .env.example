DATABASE_URL=sqlite:///./expense_management.db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional SMTP settings for password-reset emails.
# Never commit real SMTP credentials.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=FinFlow

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
AUTO_CREATE_TABLES=true

# Single administrator bootstrap.
# Change these values before any shared/public deployment.
ADMIN_NAME=FinFlow Administrator
ADMIN_EMAIL=admin@finflow.local
ADMIN_PASSWORD=
AUTO_SEED_ADMIN=true
